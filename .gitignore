# Virtualenvs (regenerable, large)
.venv/
.venv39/

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets
api.txt

# Models are ignored by default, with the production model explicitly
# included so a clone has everything required to run inference.
models/*
!models/Final/
models/Final/*
!models/Final/exp-6.edgetpu.tflite

# Inference data (large media)
inference/videos/
inference/images/

# Compiled artifacts
*.so
*.o

# OS cruft
.DS_Store
Thumbs.db
